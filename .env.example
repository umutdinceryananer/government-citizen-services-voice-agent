# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_agent_id

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=gov-citizen-services
PINECONE_ELEVENLABS_INDEX=elevenlabs-docs

# Database
DATABASE_URL=sqlite:///data/citizens.db

# Custom LLM (public URL for ElevenLabs to reach our LangGraph proxy)
# Set this to your ngrok URL when testing voice integration:
#   ngrok http 8080
#   CUSTOM_LLM_URL=https://xxxx.ngrok-free.app
CUSTOM_LLM_URL=

# Government API keys (api/security.py) — generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERNAL_API_KEY: sent by LangGraph nodes as X-Internal-Key. Required —
#   if unset, every citizen-data route returns 403 and service nodes fail.
# ADMIN_API_KEY: operator-only, sent as X-Admin-Key for DELETE /citizens/{id}
#   (GDPR erasure). Never give this key to the voice flow.
INTERNAL_API_KEY=
ADMIN_API_KEY=

# Pepper for keyed identifier hashes (api/crypto.py) — HMAC-SHA256 of TC Kimlik
# numbers and audit identifiers. Required, at least 32 characters; keep it out
# of the database and backups. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every stored hash: delete data/citizens.db and reseed.
ID_HASH_PEPPER=

# Auth webhook (api/auth.py)
# PLATFORM_WEBHOOK_SECRET: the ElevenLabs dispatch tool sends it as
#   "Authorization: Bearer <value>" — store the same value as a secret in the
#   tool's header config. Every /auth route returns 403 without it.
# SESSION_TOKEN_SECRET: signs the session_token returned on successful auth
#   (agent/session_token.py). At least 32 characters; never sent to ElevenLabs.
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PLATFORM_WEBHOOK_SECRET=
SESSION_TOKEN_SECRET=

# Twilio (Phone Integration)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+17405548808

# App Settings
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en
